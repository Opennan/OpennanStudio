{
    "name": "@opennan/desktop",
    "private": true,
    "version": "0.13.0",
    "description": "OpenNan Studio desktop app: the editor in Electron with SQLite projects, native LGPL ffmpeg export, a built-in MCP server, and a terminal panel.",
    "license": "SEE LICENSE IN LICENSE",
    "author": "OpenNan",
    "homepage": "https://github.com/Opennan/OpennanStudio",
    "type": "module",
    "main": "dist/main/index.cjs",
    "scripts": {
        "native": "node scripts/ensure-native.mjs",
        "build": "node scripts/ensure-native.mjs && tsup && node scripts/main-notices.mjs && vite build",
        "dev": "pnpm run build && electron .",
        "test": "node scripts/ensure-native.mjs && node scripts/electron-node.mjs node_modules/vitest/vitest.mjs run",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
        "fetch:ffmpeg": "node ffmpeg/fetch-ffmpeg.mjs",
        "check:ffmpeg": "node ffmpeg/check-ffmpeg-lgpl.mjs",
        "fetch:whisper": "node whisper/fetch-whisper.mjs",
        "check:whisper": "node whisper/check-whisper.mjs",
        "package": "electron-builder --config electron-builder.config.cjs --publish never",
        "smoke:packaged": "node scripts/packaged-smoke.mjs",
        "e2e": "pnpm -w exec turbo run build --filter=@opennan/desktop... && playwright test"
    },
    "dependencies": {
        "better-sqlite3": "12.11.1",
        "electron-updater": "6.8.9",
        "node-pty": "1.1.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/sdk": "^1.32.1",
        "@opennan/cloud-backend": "workspace:*",
        "@opennan/director-client": "workspace:*",
        "@opennan/export": "workspace:*",
        "@opennan/mcp": "workspace:*",
        "@opennan/mcp-schema": "workspace:*",
        "@opennan/provider-fal": "workspace:*",
        "@opennan/provider-local": "workspace:*",
        "@opennan/provider-opennan": "workspace:*",
        "@opennan/provider-sdk": "workspace:*",
        "@opennan/timeline-core": "workspace:*",
        "@opennan/timeline-media": "workspace:*",
        "@opennan/timeline-react": "workspace:*",
        "@opennan/web": "workspace:*",
        "@playwright/test": "^1.58.2",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^20.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^6.0.2",
        "@xterm/addon-fit": "0.11.0",
        "@xterm/xterm": "6.0.0",
        "electron": "44.9.0",
        "electron-builder": "26.15.3",
        "jsdom": "^29.1.1",
        "node-gyp": "^11.5.0",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "regl": "^2.1.1",
        "tsup": "^8.5.0",
        "typescript": "^5.9.0",
        "vite": "^8.3.0",
        "vitest": "^4.1.7",
        "zod": "^4.1.0"
    }
}
