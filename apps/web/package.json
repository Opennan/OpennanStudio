{
    "name": "@opennan/web",
    "private": true,
    "version": "0.11.0",
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "exports": {
        "./studio": "./src/studio.ts",
        "./styles.css": "./src/app.css"
    },
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:e2e": "vite build --mode e2e --outDir dist-e2e",
        "preview": "vite preview --port 4318 --strictPort",
        "preview:e2e": "vite preview --outDir dist-e2e --port 4318 --strictPort",
        "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.e2e.json",
        "test": "vitest run",
        "build:ffmpeg-core": "node scripts/copy-ffmpeg-core.mjs",
        "e2e": "pnpm -w exec turbo run build --filter=@opennan/web^... && pnpm run build:e2e && playwright test --project=chromium && playwright test --project=ai-serial --workers=1"
    },
    "dependencies": {
        "@ffmpeg/ffmpeg": "^0.12.15",
        "@fontsource-variable/hubot-sans": "^5.3.0",
        "@fontsource-variable/inter": "^5.3.0",
        "@fontsource/anton": "^5.3.0",
        "@fontsource/bangers": "^5.3.0",
        "@fontsource/bebas-neue": "^5.3.0",
        "@fontsource/caveat": "^5.3.0",
        "@fontsource/dancing-script": "^5.3.0",
        "@fontsource/inter": "^5.3.0",
        "@fontsource/lobster": "^5.3.0",
        "@fontsource/montserrat": "^5.3.0",
        "@fontsource/oswald": "^5.3.0",
        "@fontsource/pacifico": "^5.3.0",
        "@fontsource/playfair-display": "^5.3.0",
        "@fontsource/poppins": "^5.3.0",
        "@opennan/export": "workspace:*",
        "mediabunny": "^1.49.0",
        "@opennan/provider-fal": "workspace:*",
        "@opennan/provider-opennan": "workspace:*",
        "@opennan/provider-sdk": "workspace:*",
        "@opennan/story-film": "workspace:*",
        "@opennan/timeline-core": "workspace:*",
        "@opennan/timeline-media": "workspace:*",
        "@opennan/timeline-react": "workspace:*",
        "react": "19.2.3",
        "react-dom": "19.2.3"
    },
    "devDependencies": {
        "@ffmpeg/core": "0.12.10",
        "@playwright/test": "^1.58.2",
        "@types/node": "^20.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^6.0.2",
        "jsdom": "^29.1.1",
        "typescript": "^5.9.0",
        "vite": "^8.3.0",
        "vitest": "^4.1.7"
    }
}
