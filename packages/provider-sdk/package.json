{
    "name": "@opennan/provider-sdk",
    "version": "0.5.0",
    "description": "Provider interface of OpenNan Studio: capabilities, Job<T>, ProviderRegistry, capability-gated UI helpers, and the ai.run runner.",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": ["dist", "LICENSE", "README.md", "THIRD_PARTY_NOTICES"],
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "tsup": "^8.5.0",
        "typescript": "^5.9.0",
        "vitest": "^4.1.7"
    }
}
