{
    "name": "@opennan/timeline-react",
    "version": "0.13.0",
    "description": "React components for the OpenNan video editor: TimelineProvider, Timeline, Preview, ClipProperties.",
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "sideEffects": ["**/*.css"],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./styles.css": "./dist/styles.css",
        "./theme.css": "./dist/theme.css"
    },
    "files": ["dist", "LICENSE", "README.md"],
    "scripts": {
        "build": "rm -rf dist && tsup && pnpm run build:css",
        "build:css": "node scripts/build-scoped-preflight.mjs && tailwindcss -i src/styles.css -o dist/styles.css --minify && node scripts/scope-dist-css.mjs dist/styles.css && cp src/theme/tokens.css dist/theme.css",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@base-ui/react": "^1.2.0",
        "@opennan/timeline-core": "workspace:*",
        "@opennan/timeline-media": "workspace:*",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "intl-messageformat": "^11.2.3",
        "lucide-react": "^0.577.0",
        "tailwind-merge": "^3.5.0",
        "zustand": "^5.0.11"
    },
    "peerDependencies": {
        "@emoji-mart/data": "^1.2.1",
        "emoji-mart": "^5.6.0",
        "mediabunny": "^1.49.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "regl": "^2.1.1"
    },
    "peerDependenciesMeta": {
        "@emoji-mart/data": { "optional": true },
        "emoji-mart": { "optional": true },
        "mediabunny": { "optional": true }
    },
    "devDependencies": {
        "@emoji-mart/data": "^1.2.1",
        "@tailwindcss/cli": "^4.2.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/node": "^20.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^6.0.2",
        "emoji-mart": "^5.6.0",
        "fake-indexeddb": "^6.0.0",
        "jsdom": "^29.1.1",
        "mediabunny": "^1.49.0",
        "postcss": "^8.5.0",
        "postcss-prefix-selector": "^2.1.1",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "regl": "^2.1.1",
        "shadcn": "^4.15.0",
        "tailwindcss": "^4.2.1",
        "tsup": "^8.5.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.0",
        "vitest": "^4.1.7"
    }
}
