{
    "name": "@opennan/timeline-core",
    "version": "0.14.0",
    "description": "Framework-free timeline engine, canvas renderer, and editing operations for the OpenNan video editor.",
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "import": "./dist/*.js",
            "require": "./dist/*.cjs"
        }
    },
    "files": ["dist", "LICENSE", "README.md", "TIMELINE_RULES.md", "THIRD_PARTY_NOTICES", "THIRD_PARTY_ASSETS"],
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "zustand": "^5.0.11"
    },
    "peerDependencies": {
        "@ffmpeg/ffmpeg": "^0.12.15",
        "@ffmpeg/util": "^0.12.2",
        "vitest": "^4.1.7"
    },
    "peerDependenciesMeta": {
        "@ffmpeg/ffmpeg": { "optional": true },
        "@ffmpeg/util": { "optional": true },
        "vitest": { "optional": true }
    },
    "devDependencies": {
        "@ffmpeg/ffmpeg": "^0.12.15",
        "@ffmpeg/util": "^0.12.2",
        "@napi-rs/canvas": "^1.0.11",
        "@testing-library/jest-dom": "^6.9.1",
        "@types/node": "^20.0.0",
        "fake-indexeddb": "^6.0.0",
        "jsdom": "^29.1.1",
        "tsup": "^8.5.0",
        "typescript": "^5.9.0",
        "vitest": "^4.1.7"
    }
}
