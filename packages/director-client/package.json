{
    "name": "@opennan/director-client",
    "version": "0.3.0",
    "description": "Client for OpenNan's project pipeline routes (story plan, storyboard, scene video, copy-video): requests, quotes and tasks, plus the script cue cutter. Not used by any Studio host since cloud projects were removed.",
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": ["dist", "LICENSE", "README.md", "THIRD_PARTY_NOTICES"],
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "tsup": "^8.5.0",
        "typescript": "^5.9.0",
        "vitest": "^4.1.7"
    }
}
