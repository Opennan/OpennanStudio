{
    "name": "@opennan/director-client",
    "version": "0.2.0",
    "description": "The OpenNan AI director for OpenNan Studio: streamed director turns over SSE, turn and project-tool quotes, project pipeline tasks, the proposal allowlist, and the script cue cutter, over the cloud projects API client.",
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": ["dist", "LICENSE", "README.md", "THIRD_PARTY_NOTICES"],
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@opennan/cloud-backend": "workspace:*"
    },
    "devDependencies": {
        "@opennan/provider-opennan": "workspace:*",
        "@types/node": "^20.0.0",
        "tsup": "^8.5.0",
        "typescript": "^5.9.0",
        "vitest": "^4.1.7"
    }
}
