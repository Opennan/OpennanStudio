{
    "name": "@opennan/mcp-schema",
    "version": "0.13.0",
    "description": "Tool names and JSON schemas for the OpenNan Studio MCP server, generated from the editor command types.",
    "license": "Apache-2.0",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": ["dist", "LICENSE", "README.md", "THIRD_PARTY_NOTICES"],
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json",
        "generate": "node scripts/generate-types.mjs",
        "generate:check": "node scripts/generate-types.mjs --check"
    },
    "dependencies": {
        "@opennan/provider-sdk": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "ajv": "^8.17.1",
        "ts-json-schema-generator": "^2.9.0",
        "tsup": "^8.5.0",
        "typescript": "^5.9.0",
        "vitest": "^4.1.7"
    }
}
