{
    "name": "@opennan/cloud-backend",
    "version": "0.5.0",
    "description": "OpenNan cloud projects for OpenNan Studio: a TimelineBackend that edits a local working copy, syncs field-level changesets with the opennan.com public API, rebases remote edits, works offline, and uploads media deduplicated by SHA-256.",
    "license": "SEE LICENSE IN LICENSE",
    "type": "module",
    "sideEffects": false,
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "files": ["dist", "LICENSE", "README.md", "THIRD_PARTY_NOTICES"],
    "scripts": {
        "build": "tsup",
        "test": "vitest run",
        "typecheck": "tsc -p tsconfig.json"
    },
    "dependencies": {
        "@opennan/provider-sdk": "workspace:*",
        "@opennan/timeline-core": "workspace:*"
    },
    "devDependencies": {
        "@opennan/provider-opennan": "workspace:*",
        "@types/node": "^20.0.0",
        "fake-indexeddb": "^6.0.0",
        "tsup": "^8.5.0",
        "typescript": "^5.9.0",
        "vitest": "^4.1.7"
    }
}
